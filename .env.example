# Konfigurasi Firebase Project SmartQ&A
# Salin file ini menjadi .env dan isi dengan kredensial dari Firebase Console

VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="smart-qa-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://smart-qa-project-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="smart-qa-project"
VITE_FIREBASE_STORAGE_BUCKET="smart-qa-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

